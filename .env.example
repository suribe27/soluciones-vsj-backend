# Copie este archivo a .env y complete los valores reales.
# Nunca suba el archivo .env real al repositorio.

# Puerto en el que corre la API
PORT=4000

# Cadena de conexión a PostgreSQL (Railway la provee en su panel del proyecto)
DATABASE_URL=postgresql://vsj_user:vsj_password@localhost:5432/vsj_db

# Secreto para firmar los tokens JWT (genere uno largo y aleatorio en producción)
JWT_SECRET=cambiar-este-secreto-en-produccion

# Tiempo de expiración del token
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000
